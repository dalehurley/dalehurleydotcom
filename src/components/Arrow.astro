---
interface Props { direction?: 'right' | 'up-right'; class?: string; }
const { direction = 'right', class: className = '' } = Astro.props;
---
<svg class={`arrow-icon ${className}`} width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
  {direction === 'up-right' ? <path d="M6 18 18 6M6 6h12v12" /> : <path d="M4 12h16m-6-6 6 6-6 6" />}
</svg>
