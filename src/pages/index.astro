---
import Layout from '../layouts/Layout.astro';
import { getCollection } from 'astro:content';
import Arrow from '../components/Arrow.astro';
import PostList from '../components/PostList.astro';
import { BookOpen, Bot, Layers, Network, Package, Terminal, Workflow } from '@lucide/astro';
import '../styles/home.css';

const posts = await getCollection('blog');
const featuredPosts = posts
  .sort((a, b) => b.data.date.getTime() - a.data.date.getTime())
  .slice(0, 3);

const currentProjects = [
  { name: 'TimeLodge', desc: 'Time tracking and invoicing for freelancers and small teams.', url: 'https://timelodge.com/', image: '/images/timelodge-logo.svg' },
  { name: 'Neil the Seal', desc: 'A playful 3D browser game about a mischievous elephant seal in suburban Tasmania.', url: 'https://neiltheseal.app/', image: '/images/neil-the-seal-logo.svg' },
];

const experience = [
  { year: '2024–Present', title: 'LEAP Legal Software', role: 'AI Practice Management Engineering Lead', description: 'Created a no-code AI agentic platform for legal firms, transforming how legal professionals manage matter profitability.', image: '/images/leap-icon.webp' },
  { year: '2018–2024', title: 'Avenue Bank', role: 'Co-founder, COO & CDO', description: 'Secured $77M+ in funding, obtained a full banking licence in 2024, and built 24-hour processing systems to improve the customer experience.', image: '/images/avenue-bank-icon.webp' },
  { year: '2010–2018', title: 'CreditorWatch', role: 'Co-founder, CTO & Innovation Director', description: 'Led technology and product from startup to successful exit, pioneering AI risk scores and better credit risk assessment.', image: '/images/creditorwatch-icon.webp' },
];
const approach = [
  { title: 'Rapid prototyping', description: 'Turn ideas into working prototypes. Test early, learn from real users, and iterate.' },
  { title: 'Intelligent automation', description: 'Apply AI to complex business processes, making more room for the work that matters.' },
  { title: 'Strategic innovation', description: 'Combine technical depth with commercial thinking to build useful, sustainable products.' },
];
const openSourceProjects = [
  { name: 'Claude PHP SDK', description: 'A complete PHP client for Claude, with streaming, tool use, vision, and extended thinking.', url: 'https://github.com/claude-php/Claude-PHP-SDK', icon: Package },
  { name: 'Claude PHP Agent', description: 'Build autonomous AI agents with planning, tool orchestration, and multi-provider support.', url: 'https://github.com/claude-php/claude-php-agent', icon: Bot },
  { name: 'Laragentic', description: 'Autonomous agents and AI-powered workflows for the Laravel ecosystem.', url: 'https://github.com/laragentic', icon: Workflow },
  { name: 'PHPBot', description: 'A CLI AI assistant with cost-aware routing and on-device Apple Intelligence support.', url: 'https://github.com/dalehurley/phpbot', icon: Terminal },
  { name: 'Cross-Vendor DMF', description: 'Orchestrate models from multiple AI providers in a single pipeline.', url: 'https://github.com/dalehurley/cross-vendor-dmf', icon: Network },
  { name: 'Claude PHP SDK Laravel', description: 'Facades, service providers, and configuration for Claude in Laravel.', url: 'https://github.com/claude-php/Claude-PHP-SDK-Laravel', icon: Layers },
];
---

<Layout title="Dale Hurley — Entrepreneur, Engineer & AI Builder" description="I'm Dale Hurley. Co-founder of Avenue Bank and CreditorWatch, and an engineer building AI solutions." ogImage="/images/dale-hurley-casual.webp" ogImageWidth={1122} ogImageHeight={1402}>
  <section class="home-hero" aria-labelledby="hero-title">
    <div class="site-container hero-grid">
      <div class="hero-copy">
        <h1 id="hero-title">Building the<br /><em>AI future.</em></h1>
        <p class="hero-intro">I’m Dale, an entrepreneur and engineer turning ambitious ideas into useful products.</p>
        <p class="hero-bio">Co-founder of Avenue Bank and CreditorWatch. Now building AI solutions.</p>
        <div class="hero-actions">
          <a href="#track-record" class="button">Explore my work <Arrow /></a>
          <a href="/posts" class="text-link">Read my writing</a>
        </div>
      </div>
      <figure class="hero-portrait">
        <img src="/images/dale-hurley-casual.webp" alt="Dale Hurley" width="1122" height="1402" loading="eager" fetchpriority="high" />
        <figcaption><span>Dale Hurley</span><span>Entrepreneur &amp; engineer</span></figcaption>
      </figure>
    </div>
  </section>

  <div class="site-container">
    <dl class="proof-strip" aria-label="Career in numbers">
      {[
        { value: '$77M+', label: 'Funding secured' },
        { value: '20+', label: 'Years building' },
        { value: '16+', label: 'Products & projects' },
        { value: String(posts.length), label: 'Articles & ideas' },
      ].map(stat => <div><dt>{stat.label}</dt><dd>{stat.value}</dd></div>)}
    </dl>
  </div>

  <section id="track-record" class="site-section" aria-labelledby="experience-title">
    <div class="site-container section-split">
      <div>
        <p class="section-label">01 / Experience</p>
        <h2 id="experience-title" class="section-title">A track record of building.</h2>
        <p class="section-description">From credit risk and banking to the next generation of AI tools.</p>
      </div>
      <div class="experience-list">
        {experience.map(item => (
          <article class="experience-row">
            <div class="experience-identity"><img src={item.image} alt="" width="64" height="64" loading="lazy" /><p>{item.year}</p></div>
            <div><h3>{item.title}</h3><p class="experience-role">{item.role}</p><p class="experience-description">{item.description}</p></div>
          </article>
        ))}
      </div>
    </div>
  </section>

  <section id="ai-solutions" class="approach-section" aria-labelledby="approach-title">
    <div class="site-container approach-grid">
      <div><p class="section-label">02 / Approach</p><h2 id="approach-title" class="section-title">Ideas into working systems.</h2></div>
      {approach.map((item, index) => <div class="approach-item"><span class="section-label">0{index + 1}</span><h3>{item.title}</h3><p>{item.description}</p></div>)}
    </div>
  </section>

  <section id="open-source" class="site-section open-source-section" aria-labelledby="open-source-title">
    <div class="site-container">
      <div class="section-heading">
        <div><p class="section-label">03 / Open source</p><h2 id="open-source-title" class="section-title">Better tools. Built in the open.</h2><p class="section-description">Practical AI tools for the PHP community.</p></div>
        <a href="https://github.com/dalehurley" class="text-link" target="_blank" rel="noopener noreferrer">Explore GitHub <Arrow direction="up-right" /></a>
      </div>
      <div class="open-source-list">
        {openSourceProjects.map(project => {
          const Icon = project.icon;
          return (
            <a class="project-row" href={project.url} target="_blank" rel="noopener noreferrer">
              <span class="project-mark" aria-hidden="true"><Icon size={32} stroke-width={1.75} focusable="false" /></span>
              <div><h3>{project.name}</h3><p>{project.description}</p></div>
              <Arrow direction="up-right" />
            </a>
          );
        })}
      </div>
      <a class="community-link" href="https://codewithphp.com/" target="_blank" rel="noopener noreferrer">
        <span class="project-mark" aria-hidden="true"><BookOpen size={32} stroke-width={1.75} focusable="false" /></span>
        <h3>CodeWithPHP.com</h3><p>Learn modern PHP by building real applications. Completely free.</p><Arrow direction="up-right" />
      </a>
    </div>
  </section>

  <section id="projects" class="site-section" aria-labelledby="projects-title">
    <div class="site-container">
      <div class="section-heading"><div><p class="section-label">04 / Projects</p><h2 id="projects-title" class="section-title">Current side projects.</h2></div></div>
      <div class="ventures-list">
        {currentProjects.map(project => (
          <a href={project.url} class="project-row" target="_blank" rel="noopener noreferrer">
            <img src={project.image} alt="" width="44" height="44" loading="lazy" />
            <div><h3>{project.name}</h3><p>{project.desc}</p></div><Arrow direction="up-right" />
          </a>
        ))}
      </div>
    </div>
  </section>

  {featuredPosts.length > 0 && <section id="writing" class="site-section writing-section" aria-labelledby="writing-title">
    <div class="site-container">
      <div class="section-heading">
        <div><p class="section-label">05 / Writing</p><h2 id="writing-title" class="section-title">Notes from the build.</h2><p class="section-description">Thoughts on AI, technology, and entrepreneurship.</p></div>
        <a href="/posts" class="text-link">All writing <Arrow /></a>
      </div>
      <PostList posts={featuredPosts} headingLevel="h3" />
    </div>
  </section>}

  <section id="contact" class="contact-section" aria-labelledby="contact-title">
    <div class="site-container contact-grid">
      <h2 id="contact-title" class="section-title">Let’s build something<br /><em>worth building.</em></h2>
      <div><p>Have an ambitious idea or an interesting problem? I’m always open to a conversation.</p><a href="https://www.linkedin.com/in/dalehurley/" target="_blank" rel="noopener noreferrer" class="button">Connect on LinkedIn <Arrow direction="up-right" /></a></div>
    </div>
  </section>
</Layout>
