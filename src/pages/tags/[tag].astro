---
import Layout from '../../layouts/Layout.astro';
import PostList from '../../components/PostList.astro';
import { getCollection, type CollectionEntry } from 'astro:content';
import { formatTagLabel, normalizeTagSlug } from '../../utils/posts';
import '../../styles/writing.css';

export async function getStaticPaths() {
  const posts = await getCollection('blog');
  const tags = new Set(posts.flatMap(post => (post.data.tags ?? []).map(normalizeTagSlug)));

  return [...tags].map(tag => ({
    params: { tag },
    props: {
      tag,
      posts: posts
        .filter(post => (post.data.tags ?? []).some(value => normalizeTagSlug(value) === tag))
        .sort((a, b) => b.data.date.getTime() - a.data.date.getTime()),
    },
  }));
}

interface Props {
  tag: string;
  posts: CollectionEntry<'blog'>[];
}

const { tag, posts } = Astro.props;
const displayTag = formatTagLabel(tag);
---

<Layout
  title={`${displayTag} - Writing by Dale Hurley`}
  description={`Thoughts and notes on ${displayTag} by Dale Hurley. Explore ${posts.length} ${posts.length === 1 ? 'article' : 'articles'} on the topic.`}
  keywords={`Dale Hurley, ${displayTag}, AI, technology, entrepreneurship`}
  ogType="website"
>
  <div class="writing-page writing-topic-page site-container">
    <a href="/posts" class="text-link writing-back">
      <svg width="18" height="18" viewBox="0 0 24 24" fill="none" aria-hidden="true">
        <path d="M21 12H4m7-7-7 7 7 7" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" />
      </svg>
      All writing
    </a>
    <header class="writing-header">
      <p class="section-label">Explore a topic</p>
      <h1 class="writing-title">{displayTag}<span>.</span></h1>
      <p class="writing-intro">Thoughts, experiments, and lessons on {displayTag}.</p>
    </header>
    <div class="archive-tools topic-archive-tools">
      <p class="archive-count">{posts.length} {posts.length === 1 ? 'article' : 'articles'} <span aria-hidden="true">·</span> Newest first</p>
      <a href="/posts" class="text-link">Browse all topics <span aria-hidden="true">↗</span></a>
    </div>
    <section aria-label={`Articles about ${displayTag}`}>
      <PostList posts={posts} showTags />
    </section>
    <div class="writing-end-link"><a href="/posts" class="text-link">Back to all writing <span aria-hidden="true">↗</span></a></div>
  </div>
</Layout>
