---
import Layout from '../layouts/Layout.astro';
import '../styles/reading.css';
import Arrow from '../components/Arrow.astro';
---

<Layout
  title="Page Not Found - Dale Hurley"
  description="The page you are looking for could not be found."
>
  <div class="not-found-page site-container">
    <p class="section-label">404 / A wrong turn</p>
    <h1 class="section-title">Nothing here.<br />Plenty to explore.</h1>
    <p class="not-found-description">The page you're looking for doesn't exist or has moved. Let’s get you somewhere useful.</p>
    <div class="not-found-actions">
      <a href="/" class="button">Back to home <Arrow direction="up-right" /></a>
      <a href="/posts" class="button button-secondary">Explore the writing <Arrow /></a>
    </div>
    <nav class="not-found-links" aria-label="More places to explore">
      <a href="/#track-record" class="text-link">About Dale</a>
      <a href="/#projects" class="text-link">Projects</a>
      <a href="/principles" class="text-link">Principles</a>
      <a href="/#contact" class="text-link">Contact</a>
    </nav>
  </div>
</Layout>
