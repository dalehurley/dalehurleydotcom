---
import Layout from '../../layouts/Layout.astro';
import PostList from '../../components/PostList.astro';
import Arrow from '../../components/Arrow.astro';
import { getCollection } from 'astro:content';
import { formatTagLabel, normalizeTagSlug } from '../../utils/posts';
import '../../styles/writing.css';

const posts = (await getCollection('blog')).sort((a, b) => b.data.date.getTime() - a.data.date.getTime());
const tagCounts = new Map<string, number>();

posts.forEach(post => {
  new Set((post.data.tags ?? []).map(normalizeTagSlug)).forEach(tag => {
    tagCounts.set(tag, (tagCounts.get(tag) ?? 0) + 1);
  });
});

const topics = [...tagCounts.entries()]
  .sort((a, b) => b[1] - a[1] || a[0].localeCompare(b[0]))
  .map(([slug, count]) => ({ slug, label: formatTagLabel(slug), count }));
const popularTopics = topics.slice(0, 6);
const moreTopics = topics.slice(6);
---

<Layout
  title="Writing - Dale Hurley"
  description="Thoughts on AI, technology, and entrepreneurship. Notes from building products, experimenting with AI, and starting businesses."
  keywords="Dale Hurley writing, AI insights, technology, entrepreneurship, fintech, startups"
  ogType="website"
>
  <Fragment slot="head">
    <script type="application/ld+json" set:html={JSON.stringify({
      '@context': 'https://schema.org',
      '@type': 'Blog',
      name: 'Writing by Dale Hurley',
      description: 'Thoughts on AI, technology, and entrepreneurship.',
      url: 'https://dalehurley.com/posts',
      author: { '@type': 'Person', name: 'Dale Hurley', url: 'https://dalehurley.com' },
    })} />
  </Fragment>

  <div class="writing-page site-container" data-writing-archive>
    <header class="writing-header">
      <div class="writing-heading-row">
        <div>
          <h1 class="writing-title">Writing<span>.</span></h1>
          <p class="writing-intro">Thoughts on AI, technology, and entrepreneurship.</p>
        </div>
        <a href="/rss.xml" class="text-link writing-rss">
          Follow via RSS
          <svg width="17" height="17" viewBox="0 0 24 24" fill="none" aria-hidden="true">
            <path d="M5 19 19 5M5 5h14v14" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" />
          </svg>
        </a>
      </div>
    </header>

    {topics.length > 0 && (
      <nav class="archive-topics" aria-label="Browse writing by topic">
        <p class="archive-topics-label">Explore topics</p>
        <div class="topic-links">
          {popularTopics.map(topic => (
            <a class="topic-link" href={`/tags/${topic.slug}`}>
              {topic.label}<span>{topic.count}</span>
            </a>
          ))}
          {moreTopics.length > 0 && (
            <details class="more-topics">
              <summary>More topics <span aria-hidden="true">+</span></summary>
              <div class="more-topic-links">
                {moreTopics.map(topic => (
                  <a class="topic-link" href={`/tags/${topic.slug}`}>
                    {topic.label}<span>{topic.count}</span>
                  </a>
                ))}
              </div>
            </details>
          )}
        </div>
      </nav>
    )}

    <div class="archive-tools">
      <div class="archive-search" role="search" aria-label="Search writing">
        <label for="writing-search">Search the archive</label>
        <div class="search-input-wrap">
          <svg width="20" height="20" viewBox="0 0 24 24" fill="none" aria-hidden="true">
            <circle cx="10.75" cy="10.75" r="6.75" stroke="currentColor" stroke-width="1.5" />
            <path d="m16 16 4.5 4.5" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" />
          </svg>
          <input id="writing-search" type="search" placeholder="Search by title or topic…" autocomplete="off" aria-controls="archive-results" />
          <button class="search-clear" type="button" data-clear-search hidden>Clear</button>
        </div>
      </div>
      <p class="archive-count" role="status" aria-live="polite" aria-atomic="true" data-result-count>
        {posts.length} {posts.length === 1 ? 'article' : 'articles'} <span aria-hidden="true">·</span> Newest first
      </p>
    </div>

    <section id="archive-results" aria-label="Articles">
      <PostList posts={posts} showTags />
      <div class="archive-empty" data-empty-state hidden={posts.length > 0}>
        <h2>No articles found.</h2>
        <p>Try a different word or explore a topic above.</p>
        <button type="button" class="text-link" data-clear-search>Clear your search <Arrow direction="right" /></button>
      </div>
    </section>
    <noscript><p class="search-note">All articles are shown. Enable JavaScript to search, or use the topic links to browse.</p></noscript>
  </div>
</Layout>

<script>
  const archive = document.querySelector<HTMLElement>('[data-writing-archive]');
  const input = archive?.querySelector<HTMLInputElement>('#writing-search');
  const entries = [...(archive?.querySelectorAll<HTMLElement>('[data-post-entry]') ?? [])];
  const count = archive?.querySelector<HTMLElement>('[data-result-count]');
  const emptyState = archive?.querySelector<HTMLElement>('[data-empty-state]');
  const clearButton = archive?.querySelector<HTMLButtonElement>('.search-clear');
  const normalize = (value: string) => value.normalize('NFD').replace(/[\u0300-\u036f]/g, '').toLowerCase();
  const searchEntries = entries.map(element => ({ element, text: normalize(element.dataset.search ?? '') }));

  function filterArticles() {
    if (!input || !count || !emptyState || !clearButton) return;
    const query = input.value.trim();
    const words = normalize(query).split(/\s+/).filter(Boolean);
    let visible = 0;

    searchEntries.forEach(({ element, text }) => {
      const matches = words.every(word => text.includes(word));
      element.hidden = !matches;
      if (matches) visible += 1;
    });

    count.textContent = `${visible} ${visible === 1 ? 'article' : 'articles'}${query ? ` for “${query}”` : ' · Newest first'}`;
    emptyState.hidden = visible > 0;
    clearButton.hidden = input.value.length === 0;
  }

  input?.addEventListener('input', filterArticles);
  archive?.querySelectorAll<HTMLButtonElement>('[data-clear-search]').forEach(button => {
    button.addEventListener('click', () => {
      if (!input) return;
      input.value = '';
      filterArticles();
      input.focus();
    });
  });
  filterArticles();
</script>
