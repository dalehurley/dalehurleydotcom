---
import Layout from './Layout.astro';
import '../styles/reading.css';
import Arrow from '../components/Arrow.astro';
import { formatPostDate, normalizeTagSlug, formatTagLabel } from '../utils/posts';

interface Props {
  title: string;
  description?: string;
  date?: Date;
  author?: string;
  tags?: string[];
  image?: string;
  slug: string;
  readingTime?: number;
  relatedPosts?: Array<{
    slug: string;
    data: {
      title: string;
      description?: string;
      thumbnail?: string;
      date: Date;
      tags?: string[];
    };
  }>;
}

const { title, description, date, author = 'Dale Hurley', tags = [], image, slug, readingTime, relatedPosts = [] } = Astro.props;

const pageTitle = `${title} - Dale Hurley`;
const canonicalURL = new URL(`/posts/${slug}`, Astro.site).toString();
const ogImage = image ? new URL(image.startsWith('/') ? image : `/${image}`, Astro.site).toString() : undefined;
const publishedTime = date?.toISOString();
const twitterShareURL = `https://twitter.com/intent/tweet?text=${encodeURIComponent(title)}&url=${encodeURIComponent(canonicalURL)}`;
const linkedinShareURL = `https://www.linkedin.com/sharing/share-offsite/?url=${encodeURIComponent(canonicalURL)}`;
const keywords = tags.length
  ? [...tags, 'Dale Hurley', 'AI', 'technology', 'entrepreneurship'].join(', ')
  : 'Dale Hurley, AI, technology, entrepreneurship';
---

<Layout
  title={pageTitle}
  description={description}
  keywords={keywords}
  canonical={canonicalURL}
  ogType="article"
  ogImage={ogImage}
  author={author}
  publishedTime={publishedTime}
  tags={tags}
  articleSection="Blog"
>
  <Fragment slot="head">
    <script type="application/ld+json" set:html={JSON.stringify({
      "@context": "https://schema.org",
      "@type": "BlogPosting",
      "headline": title,
      "description": description ?? '',
      "image": ogImage ?? '',
      "author": {
        "@type": "Person",
        "name": author,
        "url": new URL('/', Astro.site).toString(),
        "sameAs": [
          "https://twitter.com/dalehurley",
          "https://linkedin.com/in/dalehurley",
          "https://github.com/dalehurley"
        ]
      },
      "publisher": {
        "@type": "Organization",
        "name": "Dale Hurley",
        "logo": { "@type": "ImageObject", "url": new URL('/images/dale-hurley-logo.png', Astro.site).toString() }
      },
      ...(publishedTime ? { "datePublished": publishedTime, "dateModified": publishedTime } : {}),
      ...(readingTime ? { "timeRequired": `PT${readingTime}M` } : {}),
      "mainEntityOfPage": { "@type": "WebPage", "@id": canonicalURL },
      ...(tags.length ? { "keywords": tags.join(', ') } : {}),
      "url": canonicalURL
    })} />

    <script type="application/ld+json" set:html={JSON.stringify({
      "@context": "https://schema.org",
      "@type": "BreadcrumbList",
      "itemListElement": [
        { "@type": "ListItem", "position": 1, "name": "Home", "item": new URL('/', Astro.site).toString() },
        { "@type": "ListItem", "position": 2, "name": "Blog", "item": new URL('/posts', Astro.site).toString() },
        { "@type": "ListItem", "position": 3, "name": title, "item": canonicalURL }
      ]
    })} />

  </Fragment>

  <div id="reading-progress" role="progressbar" aria-label="Reading progress" aria-valuemin="0" aria-valuemax="100" aria-valuenow="0"></div>

  <div class="reading-page site-container">
    <nav class="reading-breadcrumb" aria-label="Breadcrumb">
      <ol>
        <li><a href="/">Home</a></li>
        <li><a href="/posts">Writing</a></li>
        <li class="reading-breadcrumb-current" aria-current="page"><span>{title}</span></li>
      </ol>
    </nav>

    <div class="reading-column">
      <header class="reading-header">
        <h1>{title}</h1>
        {description && <p class="reading-description">{description}</p>}

        <div class="reading-meta">
          <span class="reading-author">
            <img src="/images/dale-hurley-1x1.webp" alt="" width="32" height="32" />
            {author}
          </span>
          {date && <time datetime={date.toISOString()}>{formatPostDate(date)}</time>}
          {readingTime && <span>{readingTime} min read</span>}
        </div>

        {tags.length > 0 && (
          <ul class="reading-tags" aria-label="Article topics">
            {tags.map(tag => <li><a href={`/tags/${normalizeTagSlug(tag)}`}>{formatTagLabel(tag)}</a></li>)}
          </ul>
        )}
      </header>

      {image && (
        <figure class="reading-hero">
          <img
            src={image.startsWith('/') ? image : `/${image}`}
            alt={title}
            width="1200"
            height="800"
            fetchpriority="high"
            decoding="async"
          />
        </figure>
      )}

      <article class="prose reading-prose">
        <slot />
      </article>

      <footer class="reading-actions">
        <a href="/posts" class="text-link">
          <svg class="arrow-icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" aria-hidden="true"><path d="M20 12H4m7-7-7 7 7 7" /></svg>
          All writing
        </a>
        <div class="reading-share" aria-label="Share this article">
          <span>Share</span>
          <a id="share-twitter" href={twitterShareURL} target="_blank" rel="noopener noreferrer" aria-label="Share on X (opens in a new tab)">X <Arrow direction="up-right" /></a>
          <a id="share-linkedin" href={linkedinShareURL} target="_blank" rel="noopener noreferrer" aria-label="Share on LinkedIn (opens in a new tab)">LinkedIn <Arrow direction="up-right" /></a>
          <button id="share-copy" type="button" data-url={canonicalURL} aria-describedby="share-status">Copy link</button>
        </div>
        <p id="share-status" class="reading-share-status" role="status" aria-live="polite"></p>
      </footer>
    </div>

    {relatedPosts.length > 0 && (
      <section class="reading-related" aria-labelledby="related-heading">
        <div class="reading-related-heading">
          <p class="section-label">Keep exploring</p>
          <h2 id="related-heading" class="section-title">More to think about.</h2>
        </div>
        <div class="reading-related-list">
          {relatedPosts.map(post => (
            <a href={`/posts/${post.slug}`} class="reading-related-post">
              <time datetime={post.data.date.toISOString()}>{formatPostDate(post.data.date)}</time>
              <div>
                <h3>{post.data.title}</h3>
                {post.data.description && <p>{post.data.description}</p>}
              </div>
              <Arrow />
            </a>
          ))}
        </div>
      </section>
    )}
  </div>

  <script>
    const progressBar = document.getElementById('reading-progress');
    const article = document.querySelector<HTMLElement>('.reading-prose');
    if (progressBar && article) {
      let ticking = false;
      const updateProgress = () => {
        const articleRect = article.getBoundingClientRect();
        const articleTop = articleRect.top + window.scrollY;
        const readingStart = Math.max(0, articleTop - window.innerHeight * 0.35);
        const readingEnd = articleTop + article.offsetHeight - window.innerHeight;
        const progress = Math.min(Math.max(((window.scrollY - readingStart) / Math.max(readingEnd - readingStart, 1)) * 100, 0), 100);
        progressBar.style.width = `${progress}%`;
        progressBar.setAttribute('aria-valuenow', String(Math.round(progress)));
        ticking = false;
      };
      const scheduleProgress = () => {
        if (!ticking) {
          requestAnimationFrame(updateProgress);
          ticking = true;
        }
      };
      window.addEventListener('scroll', scheduleProgress, { passive: true });
      window.addEventListener('resize', scheduleProgress, { passive: true });
      window.addEventListener('load', scheduleProgress, { once: true });
      updateProgress();
    }

    const copyBtn = document.querySelector<HTMLButtonElement>('#share-copy');
    const shareStatus = document.getElementById('share-status');
    copyBtn?.addEventListener('click', async () => {
      const url = copyBtn.dataset.url;
      if (!url || !shareStatus) return;
      try {
        await navigator.clipboard.writeText(url);
        shareStatus.textContent = 'Article link copied to clipboard.';
        copyBtn.textContent = 'Copied!';
        setTimeout(() => { copyBtn.textContent = 'Copy link'; }, 2000);
      } catch {
        shareStatus.textContent = `Couldn’t copy automatically. Copy this link: ${url}`;
      }
    });

    document.querySelectorAll('pre.astro-code').forEach((pre, index) => {
      const wrapper = document.createElement('div');
      wrapper.className = 'code-block-wrapper';
      pre.parentNode?.insertBefore(wrapper, pre);
      wrapper.appendChild(pre);

      const btn = document.createElement('button');
      btn.type = 'button';
      btn.className = 'copy-code-btn';
      btn.textContent = 'Copy';
      btn.setAttribute('aria-label', 'Copy code to clipboard');
      wrapper.appendChild(btn);

      const status = document.createElement('span');
      status.className = 'sr-only';
      status.id = `code-copy-status-${index}`;
      status.setAttribute('role', 'status');
      status.setAttribute('aria-live', 'polite');
      wrapper.appendChild(status);
      btn.setAttribute('aria-describedby', status.id);

      btn.addEventListener('click', async () => {
        const code = pre.querySelector('code')?.textContent ?? '';
        try {
          await navigator.clipboard.writeText(code);
          btn.textContent = 'Copied!';
          btn.classList.add('copied');
          status.textContent = 'Code copied to clipboard.';
          setTimeout(() => {
            btn.textContent = 'Copy';
            btn.classList.remove('copied');
          }, 2000);
        } catch {
          btn.textContent = 'Try again';
          status.textContent = 'Could not copy. Select the code to copy it manually.';
        }
      });
    });
  </script>
</Layout>
