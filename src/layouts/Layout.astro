---
import '../styles/global.css';
import '../styles/editorial.css';
import Arrow from '../components/Arrow.astro';

interface Props {
  title?: string;
  description?: string;
  keywords?: string;
  canonical?: string;
  ogType?: string;
  ogImage?: string;
  ogImageWidth?: number;
  ogImageHeight?: number;
  author?: string;
  publishedTime?: string;
  tags?: string[];
  articleSection?: string;
}

const {
  title = 'Dale Hurley - AI-Driven Tech Entrepreneur & Banking Innovation Leader',
  description = 'AI-driven tech entrepreneur, banking innovation leader, and co-founder of Avenue Bank and CreditorWatch. Expert in fintech solutions, AI automation, and startup development.',
  keywords = 'Dale Hurley, AI entrepreneur, fintech, banking innovation, Avenue Bank, CreditorWatch, AI automation',
  canonical,
  ogType = 'website',
  ogImage,
  ogImageWidth = ogImage ? undefined : 1122,
  ogImageHeight = ogImage ? undefined : 1402,
  author = 'Dale Hurley',
  publishedTime,
  tags = [],
  articleSection,
} = Astro.props;

const canonicalURL = canonical ?? new URL(Astro.url.pathname, Astro.site).toString();
const ogImageURL = new URL(ogImage ?? '/images/dale-hurley-casual.webp', Astro.site).toString();
const currentPath = Astro.url.pathname.replace(/\/$/, '') || '/';
const navigation = [
  { href: '/#track-record', label: 'Work', active: false },
  { href: '/#open-source', label: 'Open source', active: false },
  { href: '/posts', label: 'Writing', active: currentPath.startsWith('/posts') || currentPath.startsWith('/tags') },
  { href: '/principles', label: 'Principles', active: currentPath === '/principles' },
];
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>

    <meta name="description" content={description} />
    <meta name="keywords" content={keywords} />
    <meta name="author" content={author} />
    <meta name="impact-site-verification" value="4c6b0515-e8b4-46f1-b20f-342fca8e66c1" />
    <link rel="canonical" href={canonicalURL} />
    <meta name="robots" content="index, follow, max-image-preview:large, max-snippet:-1, max-video-preview:-1" />

    <!-- Performance & SEO -->
    <meta name="theme-color" content="#FF750F" />
    <meta name="msapplication-TileColor" content="#FF750F" />
    <meta name="apple-mobile-web-app-capable" content="yes" />

    <!-- Favicon -->
    <link rel="apple-touch-icon" sizes="180x180" href="/apple-touch-icon.png" />
    <link rel="icon" type="image/png" sizes="32x32" href="/favicon-32x32.png" />
    <link rel="icon" type="image/png" sizes="16x16" href="/favicon-16x16.png" />
    <link rel="manifest" href="/site.webmanifest" />

    <!-- RSS Feed -->
    <link rel="alternate" type="application/rss+xml" title="Dale Hurley Blog" href="/rss.xml" />

    <!-- Resource hints -->
    <link rel="dns-prefetch" href="//dalehurley.com" />

    <!-- Security -->
    <meta http-equiv="X-Content-Type-Options" content="nosniff" />

    <!-- Open Graph -->
    <meta property="og:type" content={ogType} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonicalURL} />
    <meta property="og:site_name" content="Dale Hurley" />
    <meta property="og:locale" content="en_US" />
    <meta property="og:image" content={ogImageURL} />
    {ogImageWidth && <meta property="og:image:width" content={ogImageWidth} />}
    {ogImageHeight && <meta property="og:image:height" content={ogImageHeight} />}
    <meta property="og:image:alt" content={title} />

    <!-- Twitter Card -->
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:site" content="@dalehurley" />
    <meta name="twitter:creator" content="@dalehurley" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogImageURL} />

    <!-- Article meta -->
    {ogType === 'article' && (
      <>
        <meta property="article:author" content={author} />
        {publishedTime && <meta property="article:published_time" content={publishedTime} />}
        {articleSection && <meta property="article:section" content={articleSection} />}
        {tags.map((tag) => <meta property="article:tag" content={tag} />)}
      </>
    )}

    <!-- Default Person JSON-LD -->
    {ogType === 'website' && (
      <script type="application/ld+json" set:html={JSON.stringify({
        "@context": "https://schema.org",
        "@type": "Person",
        "name": "Dale Hurley",
        "jobTitle": "AI-Driven Tech Entrepreneur & Banking Innovation Leader",
        "description": description,
        "url": new URL('/', Astro.site).toString(),
        "image": new URL('/images/dale-hurley-casual.webp', Astro.site).toString(),
        "sameAs": [
          "https://www.linkedin.com/in/dalehurley/",
          "https://github.com/dalehurley",
          "https://twitter.com/dalehurley"
        ],
        "worksFor": [{ "@type": "Organization", "name": "LEAP Legal Software" }],
        "knowsAbout": ["Artificial Intelligence", "Fintech", "Banking Innovation", "Startup Development"],
        "alumniOf": { "@type": "Organization", "name": "CreditorWatch" }
      })} />
    )}

    <slot name="head" />
  </head>

  <body class="site-shell">
    <a href="#main-content" class="skip-link">Skip to main content</a>
    <header id="site-header" class="site-header">
      <div class="site-container header-inner">
        <a href="/" class="site-brand" aria-label="Dale Hurley homepage">Dale Hurley<span>.</span></a>
        <nav class="desktop-nav" aria-label="Main navigation">
          {navigation.map(link => <a href={link.href} aria-current={link.active ? 'page' : undefined}>{link.label}</a>)}
          <a href="/#contact" class="button-secondary">Get in touch <Arrow direction="up-right" /></a>
        </nav>
        <button id="mobile-menu-btn" class="menu-toggle" type="button" aria-label="Open navigation menu" aria-expanded="false" aria-controls="mobile-menu">
          <span>Menu</span>
          <svg class="menu-open-icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" aria-hidden="true"><path d="M4 7h16M4 12h16M4 17h16" /></svg>
          <svg class="menu-close-icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" aria-hidden="true"><path d="m6 6 12 12M6 18 18 6" /></svg>
        </button>
      </div>
      <nav id="mobile-menu" class="mobile-nav" aria-label="Mobile navigation" hidden>
        <div class="site-container">
          {navigation.map(link => <a href={link.href} aria-current={link.active ? 'page' : undefined}>{link.label}</a>)}
          <a href="/#contact">Get in touch</a>
        </div>
      </nav>
    </header>
    <main id="main-content" tabindex="-1"><slot /></main>
    <footer class="site-footer">
      <div class="site-container footer-inner">
        <div>
          <a href="/" class="site-brand">Dale Hurley<span>.</span></a>
          <p class="footer-note">Built with curiosity. Based in Australia.</p>
        </div>
        <div class="footer-links">
          <a href="https://github.com/dalehurley">GitHub</a>
          <a href="https://x.com/dalehurley" aria-label="Dale Hurley on X">X</a>
          <a href="/rss.xml" aria-label="RSS feed">RSS</a>
          <p class="footer-copyright">&copy; {new Date().getFullYear()} Dale Hurley</p>
        </div>
      </div>
    </footer>
    <button id="back-to-top" class="back-to-top" type="button" aria-label="Back to top" hidden><Arrow /></button>
    <script>
      const menuButton = document.getElementById('mobile-menu-btn');
      const menu = document.getElementById('mobile-menu');
      const setMenuOpen = (open: boolean) => {
        if (!menu || !menuButton) return;
        menu.hidden = !open;
        menuButton.setAttribute('aria-expanded', String(open));
        menuButton.setAttribute('aria-label', open ? 'Close navigation menu' : 'Open navigation menu');
      };
      menuButton?.addEventListener('click', () => setMenuOpen(menu?.hidden ?? true));
      menu?.querySelectorAll('a').forEach(link => link.addEventListener('click', () => setMenuOpen(false)));
      document.addEventListener('keydown', event => {
        if (event.key === 'Escape' && menu && !menu.hidden) {
          setMenuOpen(false);
          menuButton?.focus();
        }
      });
      document.addEventListener('click', event => {
        if (event.target instanceof Node && !document.getElementById('site-header')?.contains(event.target)) setMenuOpen(false);
      });
      window.matchMedia('(min-width: 801px)').addEventListener('change', event => {
        if (event.matches) setMenuOpen(false);
      });
      const backToTop = document.getElementById('back-to-top');
      const updateBackToTop = () => { if (backToTop) backToTop.hidden = window.scrollY < 600; };
      window.addEventListener('scroll', updateBackToTop, { passive: true });
      updateBackToTop();
      backToTop?.addEventListener('click', () => {
        window.scrollTo({ top: 0, behavior: window.matchMedia('(prefers-reduced-motion: reduce)').matches ? 'instant' : 'smooth' });
        document.querySelector<HTMLAnchorElement>('.site-brand')?.focus({ preventScroll: true });
      });
    </script>
  </body>
</html>
